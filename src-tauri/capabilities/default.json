{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的最小权限集：核心默认权限 + SQLite 读写，不开放 shell、fs 等插件",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close"
  ]
}
