{
  "name": "eastgenesis-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web --port 1421",
    "build": "pnpm brand:theme && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "desktop:fixture": "node tools/desktop-stream-fixture.mjs",
    "desktop:fixture:smoke": "node tools/desktop-stream-fixture-smoke.mjs",
    "provider:matrix": "tsx tools/provider-matrix.ts",
    "routing:gate": "node tools/routing-gate.mjs",
    "desktop:gate": "node tools/desktop-gate.mjs",
    "desktop:evidence:validate": "node tools/desktop-evidence-validate.mjs",
    "desktop:acceptance:record": "node tools/desktop-acceptance-record.mjs",
    "desktop:webdriver:smoke": "node tools/desktop-webdriver-smoke.mjs",
    "desktop:webdriver:summary": "node tools/desktop-webdriver-summary.mjs",
    "desktop:bundle:smoke": "node tools/desktop-bundle-smoke.mjs",
    "desktop:package:smoke": "node tools/desktop-package-smoke.mjs",
    "brand:theme": "node scripts/brand/sync_theme.mjs",
    "eg": "tsx src/cli/main.ts",
    "tauri": "tauri",
    "tauri:build:qa": "tauri build --features qa-faults",
    "tauri:build:mac": "CI=true tauri build",
    "tauri:build:mac:qa": "CI=true tauri build --features qa-faults"
  },
  "dependencies": {
    "@fontsource/inter": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/montserrat": "5.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "@tauri-apps/plugin-sql": "2.5.0",
    "@typesafe-ai/sdk": "0.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "3.0.5"
  }
}
